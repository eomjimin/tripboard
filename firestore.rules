rules_version = '2';
service cloud.firestore {
  match /databases/{database}/documents {
    function email() { return request.auth.token.email.lower(); }
    function signedIn() { return request.auth != null && request.auth.token.email_verified == true; }

    function isMember(trip) { return signedIn() && email() in trip.members; }

    match /trips/{tripId} {
      allow read: if isMember(resource.data);
      // 구글로 로그인한 사람은 누구나 자기 여행을 만들 수 있고, 만든 사람이 owner·첫 멤버가 됩니다.
      allow create: if signedIn()
        && request.resource.data.owner == email()
        && request.resource.data.members is list
        && email() in request.resource.data.members;
      // 멤버는 이름·부제·날짜·태그만 고칠 수 있고, 사람 추가/삭제는 만든 사람만 합니다.
      allow update: if isMember(resource.data) && (
        email() == resource.data.owner
          ? request.resource.data.owner == resource.data.owner
          : request.resource.data.diff(resource.data).affectedKeys().hasOnly(['title', 'tag', 'start', 'end', 'places', 'cats'])
      );
      allow delete: if signedIn() && email() == resource.data.owner;

      match /{sub}/{docId} {
        allow read, write: if isMember(get(/databases/$(database)/documents/trips/$(tripId)).data);
      }
    }
  }
}
